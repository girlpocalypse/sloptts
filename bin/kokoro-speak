#!/usr/bin/python3
"""Speak text with the Kokoro TTS server (~/.local/share/kokoro-tts, kokoro-tts user service).

    kokoro-speak "some text"      speak the text
    kokoro-speak - < file.txt     speak stdin
    kokoro-speak                  speak the primary selection (highlighted text)
    kokoro-speak --clipboard      speak the clipboard
    kokoro-speak --toggle         stop if already speaking, else speak the selection (for a hotkey)
    kokoro-speak --stop           stop speaking

Only one instance speaks at a time: starting a new one stops the old one. The whole
text goes to the server in one request and plays through one pw-play, so there is
no start-up gap between sentences.
"""
import argparse
import fcntl
import json
import os
import signal
import socket
import subprocess
import sys

RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
SOCKET = os.environ.get("KOKORO_SOCKET") or os.path.join(RUNTIME_DIR, "kokoro-tts", "kokoro-tts.sock")
PIDFILE = os.path.join(RUNTIME_DIR, "kokoro-speak.pid")
PLAYER = ["pw-play", "--raw", "--rate", "24000", "--channels", "1", "--format", "f32", "-"]


def notify(message):
    print(f"kokoro-speak: {message}", file=sys.stderr)
    try:
        subprocess.run(["notify-send", "--app-name=kokoro-speak", "Kokoro TTS", message],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass


def stop_speaker(lock):
    """Stop the instance holding the lock, if any. Returns True if one was speaking."""
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.seek(0)
        try:
            os.kill(int(lock.read().strip()), signal.SIGTERM)
        except (ValueError, ProcessLookupError):
            pass
        return True
    fcntl.flock(lock, fcntl.LOCK_UN)
    return False


def selection(clipboard):
    command = ["wl-paste", "--no-newline", "--type", "text"]
    if not clipboard:
        command.append("--primary")
    try:
        result = subprocess.run(command, capture_output=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as error:
        notify(f"can't read the {'clipboard' if clipboard else 'selection'}: {error}")
        return ""
    return result.stdout.decode(errors="replace") if result.returncode == 0 else ""


def speak(text, voice, speed):
    player = sock = None
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            sock.connect(SOCKET)
        except OSError as error:
            notify(f"Kokoro server not reachable ({error}). Check: systemctl --user status kokoro-tts")
            return 1
        sock.sendall(json.dumps({"text": text, "voice": voice, "speed": speed}).encode() + b"\n")
        player = subprocess.Popen(PLAYER, stdin=subprocess.PIPE, stderr=subprocess.DEVNULL)
        while chunk := sock.recv(65536):
            player.stdin.write(chunk)
        player.stdin.close()
        player.wait()
        return 0
    except BrokenPipeError:  # pw-play went away
        return 1
    finally:
        if sock:
            sock.close()  # the server treats a disconnect as "stop"
        if player and player.poll() is None:
            player.kill()
            player.wait()


def main():
    parser = argparse.ArgumentParser(description="Speak text with Kokoro TTS.")
    parser.add_argument("text", nargs="*", help='text to speak; "-" reads stdin; none speaks the selection')
    parser.add_argument("--clipboard", action="store_true", help="speak the clipboard instead of the selection")
    parser.add_argument("--toggle", action="store_true", help="stop if already speaking, else speak")
    parser.add_argument("--stop", action="store_true", help="stop speaking and exit")
    parser.add_argument("--voice", default="af_heart")
    parser.add_argument("--speed", type=float, default=1.0)
    args = parser.parse_args()

    lock = open(PIDFILE, "a+")
    was_speaking = stop_speaker(lock)
    if args.stop or (args.toggle and was_speaking):
        return 0

    if args.text == ["-"]:
        text = sys.stdin.read()
    elif args.text:
        text = " ".join(args.text)
    else:
        text = selection(args.clipboard)
    if not text.strip():
        notify("Nothing to speak: the clipboard is empty" if args.clipboard else "Nothing to speak: no text selected")
        return 1

    # Wait for a stopped instance to let go, then hold the lock while speaking
    fcntl.flock(lock, fcntl.LOCK_EX)
    lock.truncate(0)
    lock.write(str(os.getpid()))
    lock.flush()

    def on_signal(signum, _frame):
        raise SystemExit(128 + signum)

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    return speak(text, args.voice, args.speed)


if __name__ == "__main__":
    sys.exit(main())
